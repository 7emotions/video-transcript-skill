#!/usr/bin/env python3
"""Compatibility wrapper: mimics openai-whisper CLI using faster-whisper."""

import argparse
import json
import os
import sys

from faster_whisper import WhisperModel

parser = argparse.ArgumentParser()
parser.add_argument("audio", help="Audio file to transcribe")
parser.add_argument("--output_format", default="json")
parser.add_argument("--output_dir", default=".")
parser.add_argument("--language", default=None)
parser.add_argument("--model", default="base")
parser.add_argument("--task", default="transcribe")
args = parser.parse_args()

# Infer language
lang = args.language if args.language else None

# Load model
model = WhisperModel(args.model, device="cpu", compute_type="int8")

# Transcribe
segments, info = model.transcribe(args.audio, language=lang)

# Build output
seg_list = []
for seg in segments:
    seg_list.append({
        "start": round(seg.start, 2),
        "end": round(seg.end, 2),
        "text": seg.text.strip(),
    })

result = {
    "segments": seg_list,
    "language": info.language,
}

# Write JSON
basename = os.path.splitext(os.path.basename(args.audio))[0]
json_path = os.path.join(args.output_dir, basename + ".json")
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

print(f"Saved to {json_path}", file=sys.stderr)
sys.exit(0)
